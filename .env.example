# ============================================================
# SecretWish - Environment Configuration
# ============================================================

# Database (SQLite standard; can be file path or postgresql://)
DATABASE_URL="file:./data/secretwish.db"

# Session & Security
# Generate a secure 32+ character key: openssl rand -hex 32
SESSION_SECRET="secretwish-change-me-to-a-very-secure-random-string-at-least-32-chars"

# Application URL
APP_URL="http://localhost:3000"
PORT=3000
NODE_ENV="production"

# File Uploads Directory
UPLOAD_DIR="./public/uploads"

# Optional SMTP Settings (App works completely without SMTP)
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="SecretWish <noreply@example.com>"

# Docker build option
NEXT_OUTPUT_STANDALONE="true"
